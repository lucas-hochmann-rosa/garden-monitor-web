# Copie este arquivo para ".env.local" (desenvolvimento) e configure as mesmas
# variáveis no painel da Vercel (Settings > Environment Variables) para produção.

# String de conexão do banco Neon Postgres (Settings > Connection Details no console da Neon).
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/gardenmonitor?sslmode=require"

# Segredo usado para assinar o cookie de sessão do admin (JWT). Gere um valor
# aleatório forte, ex: openssl rand -base64 32
SESSION_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# Chave que o firmware do ESP8266 envia no header "X-Api-Key" ao publicar leituras dos sensores.
# Gere um valor aleatório forte e use o mesmo valor no firmware (ver firmware/esp8266_garden_monitor).
DEVICE_API_KEY="troque-por-uma-chave-aleatoria-para-o-esp8266"

# Credenciais do único administrador (rota /admin). ADMIN_PASSWORD_HASH é o hash
# SHA-256 da senha, nunca a senha em texto puro - gere com:
#   npm run admin:hash -- "sua-senha-forte"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="troque-pelo-hash-sha256-gerado-com-npm-run-admin-hash"

# Nome da horta exibido na landing page pública. Usado só para semear a tabela
# garden_settings (npm run db:seed) - depois disso, o valor real vem do banco e pode
# ser trocado pelo admin sem precisar mudar esta variável.
GARDEN_NAME="Horta do Lucas"

# Latitude/longitude da horta, usadas para buscar o clima real da região na landing
# page (via Open-Meteo, sem necessidade de chave de API). Deixe em branco para
# ocultar o widget de clima.
WEATHER_LATITUDE=""
WEATHER_LONGITUDE=""

# Quando "true", esconde as plantas de exemplo tanto do admin (/admin/plants)
# quanto da demonstração pública (/demo) - útil depois que a horta real já tiver
# plantas cadastradas suficientes e os exemplos só estiverem no caminho. As linhas
# continuam no banco, só ficam fora da listagem.
HIDE_EXAMPLE_PLANTS=""
